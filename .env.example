# ============================================================================
# TradersRSS Environment Configuration
# ============================================================================
# Copy this file to .env.local and update with your values.
# Never commit .env.local or any file containing actual secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------

# The base URL of your application (used for generating absolute URLs)
# In development, this is typically http://localhost:3000
# In production, set to your deployed domain
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Application name (displayed in UI)
NEXT_PUBLIC_APP_NAME=TradersRSS

# ----------------------------------------------------------------------------
# RSS Feed Configuration
# ----------------------------------------------------------------------------

# Timeout for fetching individual RSS feeds (in milliseconds)
# Default: 5000 (5 seconds)
RSS_FETCH_TIMEOUT=5000

# Maximum number of concurrent RSS feed fetches
# Higher values = faster loading but more resource usage
# Default: 10
RSS_MAX_CONCURRENT_FETCHES=10

# Cache duration for RSS feeds in seconds (server-side)
# Default: 300 (5 minutes)
RSS_CACHE_DURATION=300

# Stale-while-revalidate duration in seconds
# Default: 600 (10 minutes)
RSS_STALE_WHILE_REVALIDATE=600

# ----------------------------------------------------------------------------
# API Keys (Optional - for future features)
# ----------------------------------------------------------------------------

# Example: News API key for additional data sources
# NEWS_API_KEY=your_api_key_here

# Example: Alpha Vantage API key for stock data
# ALPHA_VANTAGE_API_KEY=your_api_key_here

# Example: Financial Modeling Prep API key
# FMP_API_KEY=your_api_key_here

# ----------------------------------------------------------------------------
# Analytics (Optional)
# ----------------------------------------------------------------------------

# Google Analytics measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Plausible Analytics domain (self-hosted or cloud)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------

# Enable debug logging for RSS feed fetching
# Set to "true" to enable verbose logging
ENABLE_DEBUG_LOGGING=false

# Enable experimental features
# ENABLE_EXPERIMENTAL_FEATURES=false

# ----------------------------------------------------------------------------
# Deployment Configuration
# ----------------------------------------------------------------------------

# Node environment (automatically set by Next.js in most cases)
# NODE_ENV=development

# Port for the development server (optional, defaults to 3000)
# PORT=3000
